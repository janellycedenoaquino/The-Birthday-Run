{
  "name": "template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "email:build": "node scripts/email-build.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/types/database.types.ts",
    "check:env": "bash scripts/check-env-example.sh",
    "check:bundle": "node scripts/check-bundle-secrets.ts",
    "check:supabase-env": "node --env-file-if-exists=supabase/.env --env-file-if-exists=supabase/.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-supabase-env.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "~0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "~0.7.1",
    "cn": "~0.5.2",
    "lucide-react": "^1.70.0",
    "next": "^16.3.6",
    "next-themes": "~0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.0",
    "resend": "^6.37.0",
    "server-only": "~0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postgres": "^4.1.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
