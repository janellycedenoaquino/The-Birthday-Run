{
  "name": "template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2 <25"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "email:build": "node scripts/email-build.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/types/database.types.ts",
    "check:env": "bash scripts/check-env-example.sh",
    "check:bundle": "node scripts/check-bundle-secrets.ts",
    "check:supabase-env": "node --env-file-if-exists=supabase/.env --env-file-if-exists=supabase/.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-supabase-env.ts",
    "import:retailers": "node scripts/import-retailers.ts",
    "check:duplicates": "jscpd . --baseline-from-ref origin/main --fail-on-new-clones",
    "grant-premium": "node scripts/grant-premium.ts",
    "import:stores": "node scripts/import-stores.ts",
    "import:zips": "node scripts/import-zips.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@sentry/nextjs": "^11.12.0",
    "@supabase/ssr": "~0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "~0.7.1",
    "cn": "~0.5.2",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "6.19.0",
    "next": "^16.4.6",
    "next-themes": "~0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.13",
    "resend": "^6.38.1",
    "server-only": "~0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jscpd": "5.4.3",
    "postgres": "^4.1.1",
    "prettier": "^3.10.1",
    "shadcn": "^4.21.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
